---
const snippet =
	'<script src="https://cdn.folio.ai/embed.js" data-key="pub_live_8f3a" async></script>';
---

<section id="embed">
	<div class="wrap">
		<div class="copy">
			<h2>One line. On your site.</h2>
			<p>
				Paste this where you want the assistant. It loads the widget for the documents you
				published.
			</p>
		</div>
		<div class="panel">
			<div class="panel-bar">
				<span>index.html</span>
				<button id="copy-embed" type="button">Copy</button>
			</div>
			<pre><code><span class="punct">&lt;</span><span class="tag">script</span> <span class="attr">src</span><span class="punct">=</span><span class="str">"https://cdn.folio.ai/embed.js"</span> <span class="attr">data-key</span><span class="punct">=</span><span class="str">"pub_live_8f3a"</span> <span class="attr">async</span><span class="punct">&gt;&lt;/</span><span class="tag">script</span><span class="punct">&gt;</span></code></pre>
		</div>
	</div>
</section>

<script define:vars={{ snippet }}>
	const button = document.getElementById('copy-embed');
	if (button) {
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(snippet);
				button.textContent = 'Copied';
				window.setTimeout(() => {
					button.textContent = 'Copy';
				}, 1600);
			} catch {
				button.textContent = 'Copy failed';
				window.setTimeout(() => {
					button.textContent = 'Copy';
				}, 1600);
			}
		});
	}
</script>

<style>
	section {
		background: var(--band);
		padding: 72px 0;
	}

	.wrap {
		display: grid;
		gap: 28px;
	}

	h2 {
		margin: 0 0 12px;
		font-family: var(--serif);
		font-size: clamp(32px, 4vw, 44px);
		font-weight: 560;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.copy p {
		margin: 0;
		max-width: 36rem;
		color: var(--muted);
		font-size: 18px;
	}

	.panel {
		background: var(--ink);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: var(--shadow);
	}

	.panel-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 12px 10px 16px;
		color: #c9bfb2;
		font-family: var(--mono);
		font-size: 13px;
	}

	button {
		border: 0;
		border-radius: 999px;
		background: #f4efe6;
		color: var(--ink);
		cursor: pointer;
		font-family: var(--sans);
		font-size: 14px;
		font-weight: 700;
		padding: 8px 14px;
	}

	button:hover {
		background: white;
	}

	pre {
		margin: 0;
		padding: 8px 16px 20px;
		overflow-x: auto;
	}

	code {
		color: #f4efe6;
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.6;
		white-space: pre;
	}

	.tag {
		color: #9ddec0;
	}

	.attr {
		color: #f0d7a4;
	}

	.str {
		color: #f7c7b0;
	}

	@media (max-width: 720px) {
		code {
			white-space: pre-wrap;
		}
	}
</style>
